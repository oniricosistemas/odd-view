AI_REVIEWER_CONFIG=/etc/ai-reviewer/config.json
# API service only:
AI_REVIEWER_WEBHOOK_SECRET_FILE=/run/credentials/ai-reviewer-api.service/webhook-secret
# Worker service only:
AI_REVIEWER_APP_PRIVATE_KEY_FILE=/run/credentials/ai-reviewer-worker.service/app-private-key
AI_REVIEWER_MARKER_SECRET_FILE=/run/credentials/ai-reviewer-worker.service/marker-secret
# Optional; only when the router requires authentication:
# AI_REVIEWER_OMNIROUTE_API_KEY_FILE=/run/credentials/ai-reviewer-worker.service/omniroute-api-key
